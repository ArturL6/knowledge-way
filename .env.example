DATABASE_URL=postgresql+psycopg://knowledgeway:knowledgeway@postgres:5432/knowledgeway
REDIS_URL=redis://redis:6379/0
# Declared but read by no code path today. /api/chat returns retrieval-only answers
# regardless of what is set here; there is no chat provider implementation.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Semantic retrieval is opt-in: "none" makes no network requests. Set "openrouter" or
# "vertex", and supply that provider's credentials below. Vertex requires ADC mounted
# read-only in the API/worker containers; OpenRouter needs only the key.
EMBEDDING_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_EMBEDDING_DIMENSIONS=768
REPOSITORY_STORAGE_PATH=/data/repositories
MAX_FILE_SIZE=1048576
INDEX_JOB_TIMEOUT=1800
MAX_INDEX_WORKERS=2
EMBEDDING_BATCH_SIZE=32
CHAT_CONTEXT_LIMIT=12000
CORS_ORIGINS=http://localhost:3000
# Git credentials: leave empty for public HTTPS repositories. Secret *file paths*
# only; do not put tokens or keys in this file or in a clone URL.
GIT_SSH_KEY_PATH=
GIT_SSH_KNOWN_HOSTS_PATH=
GIT_HTTPS_TOKEN_FILE=
GIT_HTTPS_USERNAME=x-access-token
