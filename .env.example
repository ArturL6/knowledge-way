# Every setting in apps/api/app/config.py is overridable by the matching upper-case name here.
# This file lists all of them with their defaults, because a setting that is only discoverable
# by reading config.py is indistinguishable from a setting that does not exist.

# A bare KEY= sets an empty string, not "unset", which is a visible difference for the
# optional str|None settings below. They are left commented out so they stay discoverable
# while keeping their None default; uncomment with a real value to use them.

DATABASE_URL=postgresql+psycopg://knowledgeway:knowledgeway@postgres:5432/knowledgeway
REDIS_URL=redis://redis:6379/0

# Declared but read by no code path. /api/chat returns retrieval-only answers no matter what is
# set here: there is no chat provider implementation.
# OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- Semantic retrieval -------------------------------------------------------------------
# Production uses OpenRouter with openai/text-embedding-3-small (1536 dimensions). This
# keyless quickstart profile deliberately overrides it to "none" so it makes no embedding
# network requests. "vertex" remains an available adapter needing VERTEX_PROJECT_ID and ADC.
EMBEDDING_PROVIDER=none
EMBEDDING_BATCH_SIZE=32
# Per-input ceiling. text-embedding-3-small rejects anything over 8192 tokens and one oversized
# member used to fail its whole batch. Source code runs near three characters per token.
EMBEDDING_MAX_INPUT_CHARACTERS=20000
# OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_EMBEDDING_DIMENSIONS=768

# --- Code cards ---------------------------------------------------------------------------
# Versioned LLM summaries of symbols, spliced into the embedded retrieval document. Opt-in
# because a run over every symbol in a large repository costs real money.
CODE_CARDS_ENABLED=false
# Production cards use "openrouter" and reuse OPENROUTER_API_KEY above; "vertex" remains
# available with ADC and VERTEX_PROJECT_ID. The model must support structured outputs: a card is
# persisted only if it validates against CodeCardDetails.
CODE_CARD_PROVIDER=openrouter
OPENROUTER_CARD_MODEL=deepseek/deepseek-v4-flash-0731
# Only consulted when CODE_CARD_PROVIDER=vertex:
VERTEX_GEMINI_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3.5-flash-lite
CODE_CARD_MAX_SOURCE_CHARACTERS=12000
# Bounded in-flight requests. Keep small to respect provider quota.
CODE_CARD_REQUEST_CONCURRENCY=8

# --- Reranking ----------------------------------------------------------------------------
# Opt-in per query, over a bounded candidate set. "cohere" needs COHERE_API_KEY and RERANK_MODEL.
RERANK_PROVIDER=none
# RERANK_MODEL=
# COHERE_API_KEY=
RERANK_CANDIDATE_LIMIT=40

# --- Indexing -----------------------------------------------------------------------------
REPOSITORY_STORAGE_PATH=/data/repositories
MAX_FILE_SIZE=1048576
# Full parser-graph rebuilds of large repositories can exceed RQ's default timeout.
INDEX_JOB_TIMEOUT=1800
CHAT_CONTEXT_LIMIT=12000
CORS_ORIGINS=http://localhost:3000

# --- Git credentials ----------------------------------------------------------------------
# Leave empty for public HTTPS repositories. Secret *file paths* only; never put a token or key
# in this file or in a clone URL, because clone URLs are stored and returned by the API.
# GIT_SSH_KEY_PATH=
# GIT_SSH_KNOWN_HOSTS_PATH=
# GIT_HTTPS_TOKEN_FILE=
GIT_HTTPS_USERNAME=x-access-token
